<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#FFFFFF">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="مشخصات" android:textSize="30sp" android:textStyle="bold" android:gravity="center"/>
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#DDDDDD" android:layout_marginTop="12dp" android:layout_marginBottom="14dp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="● Online" android:textSize="18sp" android:textColor="#168A35"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تصاویر زنده از گوشی کودک" android:textSize="21sp" android:textStyle="bold"
            android:layout_marginTop="22dp" android:layout_marginBottom="12dp"/>
        <FrameLayout android:id="@+id/liveContainer" android:layout_width="match_parent"
            android:layout_height="300dp" android:background="@drawable/live_border"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="تنظیمات ضبط از صفحه" android:textSize="19sp" android:textStyle="bold"
            android:layout_marginTop="22dp"/>
        <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ping: —   •   کیفیت: —   •   FPS: —&#10;رزولوشن: —   •   اتصال: —"
            android:textSize="16sp" android:layout_marginTop="10dp"/>
    </LinearLayout>
</ScrollView>